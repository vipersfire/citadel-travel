{
  "name": "citadel-travel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -k -n api,web \"corepack pnpm --filter @citadel/api dev\" \"corepack pnpm --filter @citadel/web dev\"",
    "build": "corepack pnpm --filter @citadel/web build",
    "typecheck": "corepack pnpm --filter @citadel/web typegen && tsc --noEmit",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "worker": "tsx apps/api/src/worker.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "format": "prettier --write apps packages scripts infra docs README.md *.json *.ts",
    "lint": "eslint apps packages scripts tests --max-warnings 0",
    "check:flow": "tsx scripts/check-flow.ts",
    "admin:reset-totp": "tsx scripts/reset-admin-totp.ts",
    "check:ui": "tsx scripts/check-ui.ts",
    "check:browser-flow": "tsx scripts/check-browser-flow.ts",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "test:postgres": "vitest run tests/postgres.test.ts",
    "check:axe": "tsx scripts/check-accessibility.ts",
    "keys:rotate": "tsx scripts/rotate-encryption.ts",
    "check:performance": "tsx scripts/check-performance.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "turbo": "^2.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
