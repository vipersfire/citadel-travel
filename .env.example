# Copy to .env in the workspace root. Never commit real secrets.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Exact additional browser origins, comma-separated. Add your LAN IP to use another device.
APP_ALLOWED_ORIGINS=
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
# Empty uses persistent local PGlite. PostgreSQL 16+ supported.
DATABASE_URL=
# Required in production: random 32+ char secret; encryption key is 64 hex chars.
SESSION_SECRET=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Production public-media storage. Private booking documents stay on the shared local volume.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
# Development defaults; production never uses the simulated provider.
PAYMENT_PROVIDER=development
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
EMAIL_PROVIDER=development
RESEND_API_KEY=
EMAIL_FROM=Citadel <journeys@example.com>
WHATSAPP_ENABLED=false
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
SENTRY_DSN=
# Set both to create an admin; no hardcoded login. First login enrolls TOTP.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional deployment/local Docker configuration
DOMAIN=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=citadel
MINIO_ROOT_PASSWORD=

# Optional operational configuration
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_PREVIOUS_KEYS=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
SENTRY_DSN_PUBLIC=
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=

# Exact proxy CIDRs separated by spaces; obtain Cloudflare ranges from its official list.
# Empty means only loopback, never trust arbitrary public forwarded headers.
TRUSTED_PROXY_CIDRS=127.0.0.1/32 ::1/128
TRUST_PROXY=
LOG_LEVEL=info
